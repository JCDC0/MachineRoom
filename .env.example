PAPERCLIP_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=your-company-id
# Company project and workspace ids for a new task, when Paperclip needs them.
PAPERCLIP_PROJECT_ID=
PAPERCLIP_WORKSPACE_ID=
PROJECT_ROOT=/absolute/path/to/project
# Folder that holds TASKS.md, HOUSE-RULES.md, lanes.json and policy.json. Default: PROJECT_ROOT/docs/agents.
BRIEFS_DIR=
PORT=5174
# Other local pages the bridge allows, as http://localhost:N or http://127.0.0.1:N, separated by commas.
MACHINEROOM_ORIGINS=
# Settings file for the assistant. Default: none.
MACHINEROOM_SETTINGS_FILE=
# Model for the assistant. Uncomment to change the default opencode/deepseek-v4.1-flash-free, or set it to off.
# ASSISTANT_MODEL=
# Path to the opencode program, when it is not on PATH.
OPENCODE_BIN=
# Model for the decision route. Default: typesafe/jev-1.14.
DECISION_MODEL=
# Key for the decision route. The route answers 404 without it.
OPENROUTER_API_KEY=
# Paperclip token for scripts/frames-from-runs.mjs, when Paperclip needs one.
PAPERCLIP_API_KEY=
